# ========================
# DATABASE
# ========================
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/kirtibuildwell

# ========================
# JWT & AUTH
# ========================
JWT_SECRET=your_secret_key_here

# ========================
# ZOHO CRM
# ========================
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret

# ========================
# BREVO (PRIMARY EMAIL API)
# ========================
# Brevo transactional email API credentials and settings.
BREVO_API_KEY=your_brevo_api_key_here
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_FROM_EMAIL=noreply@kirtibuildwell.com
BREVO_FROM_NAME=KirtiBuildWell
BREVO_REPLY_TO=info@kirtibuildwell.com

# ========================
# NO SMTP CONFIGURATION REQUIRED
# ========================
# Users receive emails from Brevo, and admin notifications land in the Zoho Mail inbox.

# ========================
# FRONTEND
# ========================
FRONTEND_URL=https://kirti-build-well.vercel.app

# ========================
# PORT
# ========================
PORT=3001
NODE_ENV=production
