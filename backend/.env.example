# ========================
# DATABASE
# ========================
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/kirtibuildwell

# ========================
# JWT & AUTH
# ========================
JWT_SECRET=your_secret_key_here

# ========================
# ZOHO CRM
# ========================
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret

# ========================
# POSTMARK (PRIMARY EMAIL)
# ========================
# Used first for confirmation/admin emails when configured.
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
POSTMARK_FROM_EMAIL=noreply@kirtibuildwell.com
POSTMARK_FROM_NAME=KirtiBuildWell
POSTMARK_MESSAGE_STREAM=outbound

# ========================
# MAILGUN (FALLBACK)
# ========================
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM_EMAIL=noreply@kirtibuildwell.com
MAILGUN_FROM_NAME=KirtiBuildWell

# ========================
# SMTP EMAIL (OPTIONAL FALLBACK)
# ========================
# Zoho Mail SMTP Settings
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURE=false
ZOHO_SMTP_USER=your-email@yourdomain.com
ZOHO_SMTP_PASS=your-app-specific-password
ZOHO_SMTP_FROM_EMAIL=info@kirtibuildwell.com
ZOHO_SMTP_FROM_NAME=KirtiBuildWell

# ========================
# FRONTEND
# ========================
FRONTEND_URL=https://kirti-build-well.vercel.app

# ========================
# PORT
# ========================
PORT=3001
NODE_ENV=production
